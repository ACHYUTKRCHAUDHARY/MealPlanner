DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/plateful
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_SECONDS=12
RATE_LIMIT_PER_MINUTE=10

# Email Configuration (Optional, prints to console if empty in development)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@plateful.local
